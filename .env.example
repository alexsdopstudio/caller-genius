# Nessuna chiamata o messaggio reale finché una delle due opzioni è true.
DRY_RUN=true
MOCK_MODE=true
MOCK_CALENDAR=true
DATABASE_URL=sqlite+aiosqlite:///./voice_funnel.db
PUBLIC_BASE_URL=http://localhost:8000
TIMEZONE=Europe/Rome
# Cambiare tutte e tre prima di esporre il servizio in rete.
ADMIN_USER=admin
ADMIN_PASSWORD=local-development-password
SECRET_KEY=local-development-signing-key-change-me
TOOL_API_KEY=local-development-tool-key
MAGIC_LINK_MAX_AGE=604800
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=
# Alternativa: file OAuth authorized-user con refresh_token, client_id, client_secret.
GOOGLE_OAUTH_FILE=
CALENDAR_START_HOUR=9
CALENDAR_END_HOUR=18
MEETING_MINUTES=10
